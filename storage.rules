rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all dress media
    match /dresses/{allPaths=**} {
      allow read: if true;
      // Allow authenticated users to write (simplified for emulator testing)
      allow write: if request.auth != null;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
